<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed dark theme (not DayNight), deliberately: this runs on a handset used outdoors
         in the field, where a consistent, high-contrast look matters more than following the
         OS light/dark setting. -->
    <style name="Theme.SiyiMk15Teleop" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
</resources>
