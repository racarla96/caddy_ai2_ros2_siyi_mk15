<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card background for each driving-profile block in SettingsActivity, one per
     CH7 switch position. Kept as a plain shape drawable (no image assets) to match the
     rest of this field-testing tool's minimal-dependency style. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14000000" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#33000000" />
    <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="16dp" />
</shape>
